{
  "name": "umbra-war-room",
  "productName": "UMBRA",
  "version": "0.15.2",
  "description": "Communications et escouades pour les équipes Wardogs",
  "author": "UMBRA contributors",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "package": "electron-packager . UMBRA --platform=win32 --arch=x64 --out=../package --icon=assets/umbra.ico --prune=true --ignore=^/tests --ignore=^/artifacts --overwrite --ignore=^/assets/wardogs-reference.png --asar.unpack=**/*.node --ignore=^/runtime",
    "test:voice": "node tests/voice.mjs",
    "build:voice": "esbuild node_modules/livekit-client/dist/livekit-client.esm.mjs --bundle --format=esm --platform=browser --minify --outfile=assets/livekit.mjs",
    "test:devices": "node tests/devices.mjs",
    "dist": "npm run dist:unsigned && node scripts/sign-release.cjs dist",
    "sign:release": "node scripts/sign-release.cjs",
    "dist:signed": "electron-builder --config electron-builder-signed.json --win nsis --x64 --publish never && node scripts/sign-release.cjs",
    "test:vad": "node tests/vad.mjs",
    "test:channels": "node tests/channels-ui.mjs",
    "test:profiles": "node tests/personalization-ui.mjs",
    "test:session": "node tests/session-update-ui.mjs",
    "test:team": "node tests/team-ui.mjs",
    "build:vendors": "esbuild scripts/chat-vendor.mjs --bundle --format=esm --platform=browser --minify --outfile=assets/chat-vendor.mjs && npm run build:voice",
    "build:licenses": "node scripts/build-licenses.cjs",
    "dist:unsigned": "npm run build:licenses && electron-builder --config electron-builder.json --win nsis --x64 --publish never",
    "dist:signpath": "npm run build:licenses && electron-builder --config electron-builder.signpath.cjs --win nsis --x64 --publish never",
    "check:public": "node scripts/check-public.mjs",
    "test:companion": "node tests/companion-ui.mjs",
    "test:media": "node tests/media-ui.mjs"
  },
  "devDependencies": {
    "@actions/artifact": "4.0.0",
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "highlight.js": "^11.11.1",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "markdown-it": "^15.0.2",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "homepage": "https://umbra.lotus-order.fr/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SyntetikkCODE/UMBRA.git"
  }
}
